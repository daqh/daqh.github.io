{% macro publication(authors, year, kind, title, venue, venueShort, paperUrl, codeUrl, posterUrl="", color) %}
    <li class="list-group-item">
        <a>
            <span class="badge text-bg-{{color}}">{{ venueShort }}</span>
        </a>
        <span class="text-muted">{{ year }}</span>
        &#183;
        <span class="text-muted">{{ kind }}</span>
        <h4>{{ title }}</h4>
        <p>
            {{ authors }}
            <br>
            <span class="text-muted">
                <small>{{ venue }}</small>
            </span>
        </p>
        {% if paperUrl %}
            <a href="{{ paperUrl }}" target="_blank" class="btn btn-outline-primary btn-sm">Paper</a>
        {% endif %}
        {% if codeUrl %}
            <a href="{{ codeUrl }}" target="_blank" class="btn btn-outline-primary btn-sm">Code</a>
        {% endif %}
        {% if posterUrl %}
            <a href="{{ posterUrl }}" target="_blank" class="btn btn-outline-primary btn-sm">Poster</a>
        {% endif %}
    </li>
{% endmacro %}
